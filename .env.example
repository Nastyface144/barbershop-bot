# Токен бота от @BotFather
BOT_TOKEN=123456789:AAAA-your-token-here

# Telegram ID администратора (можно несколько через запятую)
ADMIN_ID=123456789

# Часовой пояс барбершопа
TIMEZONE=Europe/Moscow

# Токен онлайн-оплаты от @BotFather (Bot Settings → Payments).
# Оставьте пустым, чтобы принимать оплату только в салоне.
PAYMENT_TOKEN=

# На сколько дней вперёд открыта запись (1–90)
BOOKING_DAYS=30

# Путь к файлу базы данных SQLite
DB_PATH=barbershop.db
